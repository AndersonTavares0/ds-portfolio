# Copy this file to `.env` and adjust if needed:  cp .env.example .env
#
# `.env` is git-ignored. NEVER commit real credentials.
#
# Docker Compose reads this file automatically (same directory as
# docker-compose.yml), and `tasks.py` loads it for the dbt and Python steps,
# so one file configures the whole stack.

# --- PostgreSQL (the `db` service in docker-compose.yml) ---
# NOTE: 5433, not 5432. A PostgreSQL installed natively on the host (Fedora
# ships one) binds 5432 and would silently shadow this container's mapping,
# sending your queries to the wrong server. The container still listens on
# 5432 internally; only the host port is moved.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=olist

# --- Data acquisition ---
# The dataset is downloaded anonymously from the Hugging Face Hub.
# `OLIST_REVISION` pins an immutable revision so the pipeline stays
# reproducible even if the dataset is updated upstream. Override only if you
# deliberately want a different snapshot.
OLIST_REVISION=5acf1f37d7197d4979e714721a1ec13a7c3da728
